# URL del backend de Kairo (sin barra final).
# En local: el servidor de LoLTracker/server corre en el puerto 3000.
VITE_API_URL=http://localhost:3000
# Producción: VITE_API_URL=https://kairo-api-nqts.onrender.com

# Enlace de descarga de la app (opcional; este es el valor por defecto)
VITE_APK_URL=https://github.com/0scar07/Kairo/releases/latest/download/Kairo.apk
